# Copy to .env.local to bake your Google OAuth client ID into local builds.
# (You can also paste it into Settings in the app instead.)
VITE_GOOGLE_CLIENT_ID=

# Your deployed app. Local copies (the dev server, previews) show a "Test copy"
# banner that links here. The GitHub Pages workflow sets this on its own.
VITE_APP_URL=https://<user>.github.io/<repo>/
